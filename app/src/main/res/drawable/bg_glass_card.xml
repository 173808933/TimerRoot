<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 顶部内高光：四角都圆，靠 gravity 贴在顶部，避免底部露出方角 -->
    <item android:top="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/highlight_top"
                android:endColor="#00FFFFFF"
                android:type="linear" />
            <corners android:radius="@dimen/radius_card" />
        </shape>
    </item>
    <!-- 玻璃基色 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_card" />
            <corners android:radius="@dimen/radius_card" />
            <stroke android:width="1dp" android:color="@color/stroke" />
        </shape>
    </item>
</layer-list>
